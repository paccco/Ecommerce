---
import LayoutPrado from '../../layouts/LayoutPrado.astro';
import productos from '../../../data/productos.json';

export async function getStaticPaths() {
  return productos.map((pr) => ({
    params: { slug: pr.título.toLowerCase() },
    props: { producto: pr }
  }));
}

interface Producto {
  título: string;
  texto_precio: string;
  imagen: string;
  descripcion: string;
}

const { producto } = Astro.props as { producto: Producto };
---

<LayoutPrado title={`Ficha Técnica - ${producto.título}`}>
  <div class="py-6">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs uppercase tracking-widest text-gray-400 mb-8 font-montserrat">
      <a href="/ssg" class="hover:text-amber-950 transition">Catálogo SSG</a>
      <span>/</span>
      <span class="text-gray-600 font-bold">{producto.título}</span>
    </nav>

    {/* Split Detail Container */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      {/* Product Image Section */}
      <div class="bg-white border border-amber-900/5 rounded-3xl p-12 flex justify-center items-center shadow-md relative overflow-hidden">
        <img 
          src={`/images/${producto.imagen}`} 
          alt={producto.título} 
          class="max-w-[85%] max-h-[400px] object-contain drop-shadow-[0_15px_15px_rgba(0,0,0,0.25)] hover:scale-105 transition-transform duration-300 z-10"
        />
        <div class="absolute inset-0 bg-gradient-to-tr from-amber-50/5 via-transparent to-transparent pointer-events-none"></div>
      </div>

      {/* Product Metadata & Action Section */}
      <div class="space-y-6 text-left">
        <div class="space-y-2">
          <span class="font-montserrat text-xs uppercase tracking-[0.2em] font-extrabold text-amber-700">Ficha Histórica</span>
          <h1 class="font-garamond text-5xl text-gray-900 tracking-wide uppercase">{producto.título}</h1>
          <p class="font-montserrat text-2xl text-amber-950 font-medium">{producto.texto_precio}</p>
        </div>

        <div class="w-full h-[1px] bg-amber-900/10"></div>

        <div class="space-y-4">
          <h3 class="font-montserrat text-xs uppercase tracking-wider font-bold text-gray-700">Descripción de la Pieza</h3>
          <p class="font-garamond italic text-gray-500 text-lg leading-relaxed">
            {producto.descripcion}
          </p>
        </div>

        <div class="space-y-3 pt-4">
          <div class="flex gap-4 text-xs font-montserrat text-gray-400">
            <span class="w-24 uppercase tracking-widest font-bold">Estado:</span>
            <span class="text-emerald-600 font-bold uppercase tracking-wider">● En Stock Estático</span>
          </div>
          <div class="flex gap-4 text-xs font-montserrat text-gray-400">
            <span class="w-24 uppercase tracking-widest font-bold">Edición:</span>
            <span class="text-gray-600">Limitada - SSG</span>
          </div>
        </div>

        <div class="pt-8 flex gap-4">
          <button 
            onclick="alert('¡Compra de coleccionista procesada estáticamente!')"
            class="flex-1 bg-amber-900 hover:bg-amber-800 text-white font-montserrat text-xs uppercase tracking-widest font-bold py-4 rounded-xl shadow-lg hover:shadow-xl transition duration-300 cursor-pointer"
          >
            Adquirir Pieza
          </button>
          <a 
            href="/ssg" 
            class="px-6 border border-amber-900/20 hover:border-amber-950 text-amber-950 flex items-center justify-center rounded-xl text-xs uppercase tracking-widest font-bold font-montserrat transition"
          >
            Volver
          </a>
        </div>
      </div>
    </div>
  </div>
</LayoutPrado>
