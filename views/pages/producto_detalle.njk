{% extends "layouts/base.njk" %}

{% block title %}Detalle de {{ product.name }}{% endblock %}

{% block content %}
    <div style="max-width: 800px; margin: 2rem auto; background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); display: flex; flex-wrap: wrap; gap: 2rem;">
        <div style="flex: 1; min-width: 280px; text-align: center;">
            {% if product.imageUrl %}
                <img src="{{ product.imageUrl }}" alt="{{ product.name }}" style="max-width: 100%; max-height: 400px; object-fit: contain; border-radius: 8px;">
            {% else %}
                <div style="width: 100%; height: 300px; background: #eee; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-weight: bold; color: #777;">Sin Imagen</div>
            {% endif %}
        </div>
        
        <div style="flex: 1.2; min-width: 280px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <h2 style="font-size: 2.2rem; margin-top: 0; color: #333; font-family: sans-serif; font-weight: bold; text-transform: capitalize;">{{ product.name }}</h2>
                <p style="font-size: 1.1rem; color: #666; line-height: 1.6; margin-bottom: 1.5rem;">{{ product.description }}</p>
                <p style="font-size: 1.8rem; font-weight: bold; color: #28a745; margin: 0 0 1rem 0;">${{ product.price }}</p>
                <p style="font-size: 0.9rem; color: #777; margin: 0;">Disponibilidad: 
                    {% if product.stock > 0 %}
                        <span style="color: #28a745; font-weight: bold;">En Stock ({{ product.stock }} unidades)</span>
                    {% else %}
                        <span style="color: #dc3545; font-weight: bold;">Agotado</span>
                    {% endif %}
                </p>
            </div>

            {% if product.stock > 0 %}
                <form action="/carrito/agregar" method="POST" style="margin-top: 1.5rem; border-top: 1px solid #eee; padding-top: 1.5rem;">
                    <input type="hidden" name="productId" value="{{ product.id }}">
                    <div style="margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                        <label for="quantity" style="font-weight: bold; color: #555;">Cantidad:</label>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" max="{{ product.stock }}" style="width: 70px; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem; text-align: center;">
                    </div>
                    <button type="submit" class="btn" style="background: #007bff; color: white; padding: 0.8rem 1.5rem; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 1rem; transition: background 0.2s;">
                        Agregar al Carrito 🛒
                    </button>
                </form>
            {% else %}
                <div style="margin-top: 1.5rem; padding: 1rem; background: #fff3cd; color: #856404; border-radius: 6px; font-weight: bold; text-align: center;">
                    Este producto no está disponible temporalmente.
                </div>
            {% endif %}

            <div style="margin-top: 2rem; border-top: 1px solid #eee; padding-top: 1rem;">
                <a href="/productos" style="text-decoration: none; color: #007bff; font-weight: bold; display: inline-flex; align-items: center; gap: 0.5rem;">
                    ← Volver al Catálogo
                </a>
            </div>
        </div>
    </div>
{% endblock %}
